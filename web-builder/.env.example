# Copy this to .env and fill in your values
XNEELO_DB_HOST=sql16.cpt3.host-h.net
XNEELO_DB_PORT=3306
XNEELO_DB_NAME=your_db_name
XNEELO_DB_USER=your_db_user
XNEELO_DB_PASSWORD=your_db_password
SESSION_SECRET=change-this-to-a-long-random-string

# Optional: SMTP for lead email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.co.za
