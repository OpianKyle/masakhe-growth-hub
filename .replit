modules = ["nodejs-20", "web", "postgresql-16"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "NODE_ENV=production npx tsx server/index.ts"]
build = ["npm", "run", "build"]
publicDir = "dist"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[userenv]

[userenv.shared]
XNEELO_DB_HOST = "sql16.cpt3.host-h.net"
XNEELO_DB_PORT = "3306"
XNEELO_DB_NAME = "opiandigital"
XNEELO_DB_USER = "admin"
ADUMO_ENV = "staging"
APP_URL = "https://masakhegroup.co.za"
ADUMO_API_URL = "https://staging-apiv3.adumoonline.com/product/payment/v1/initialisevirtual"
ADUMO_APPLICATION_ID = "4794E7D1-F159-4A02-936F-65A20BD901C6"
ADUMO_MERCHANT_ID = "9BA5008C-08EE-4286-A349-54AF91A621B0"
SMTP_HOST = "smtp.masakhegroup.co.za"
SMTP_PORT = "465"
